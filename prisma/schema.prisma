// TemanNakes P1 data model
// Dev uses SQLite for zero-setup local development (enums aren't supported by
// the sqlite connector, so Role/Profession/SubmissionStatus/SubscriptionType
// are plain strings validated in app code — see src/lib/constants.ts).
// For production, switch provider to "postgresql" and set DATABASE_URL
// accordingly (enums can be reintroduced at that point if desired).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("NAKES") // NAKES | ADMIN
  isActive     Boolean  @default(true)
  credits      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nakesProfile        NakesProfile?
  createdWebinars     Webinar[]           @relation("WebinarCreatedBy")
  createdJobPostings  JobPosting[]        @relation("JobPostingCreatedBy")
  reviewedSubmissions ServiceSubmission[] @relation("SubmissionReviewedBy")
  subscriptions       Subscription[]
  institutionsAdded   Institution[]       @relation("InstitutionAddedBy")
  creditTransactions  CreditTransaction[] @relation("CreditOwner")
  creditGrants        CreditTransaction[] @relation("CreditGrantedBy")
  topupRequests       TopupRequest[]      @relation("TopupOwner")
  topupReviews        TopupRequest[]      @relation("TopupReviewedBy")
  passwordResetTokens PasswordResetToken[]
}

// Ledger of every credit change: positive = topup by admin, negative = a
// document unlocked by the nakes. User.credits is the running balance.
model CreditTransaction {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation("CreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  note         String?
  submissionId String?
  submission   ServiceSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?              @relation("CreditGrantedBy", fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([userId])
}

model NakesProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName              String
  profession            String   // TTLM | PERAWAT | TENAGA_VOKASI_FARMASI | APOTEKER | DOKTER_UMUM | BIDAN | LAINNYA
  educationLevel        String
  yearsOfService        Int
  serviceResponsibility String
  strNumber             String
  sipNumber             String
  sipValidUntil         DateTime
  position              String

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  submissions           ServiceSubmission[]
}

model Institution {
  id            String   @id @default(cuid())
  name          String
  letterheadUrl String
  addedById     String
  addedBy       User     @relation("InstitutionAddedBy", fields: [addedById], references: [id])
  createdAt     DateTime @default(now())

  submissions   ServiceSubmission[]

  @@unique([name])
}

model ActivityTemplate {
  id         String   @id @default(cuid())
  profession String
  groupLabel String?
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  entries    ServiceEntry[]
}

model ServiceSubmission {
  id             String       @id @default(cuid())
  nakesProfileId String
  nakesProfile   NakesProfile @relation(fields: [nakesProfileId], references: [id], onDelete: Cascade)

  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id])

  profession     String
  periodStart    DateTime
  periodEnd      DateTime
  periodMonths   Int          // 6 or 12

  // Identity printed on this document, copied from the profile when created
  // and editable per document, so later profile edits don't alter old PDFs.
  // Nullable only for rows created before these fields existed.
  fullName       String?
  strNumber      String?
  sipNumber      String?
  sipValidUntil  DateTime?
  position       String?
  employeeNip    String?
  supervisorName String?
  supervisorNip  String?
  city           String?

  // Set when the nakes spends credits (or an admin grants access); unlocks
  // clean PDF download and editing after submission.
  unlockedAt     DateTime?

  status         String       @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  adminNote      String?
  reviewedById   String?
  reviewedBy     User?        @relation("SubmissionReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  entries            ServiceEntry[]
  evidenceFiles      EvidenceFile[]
  creditTransactions CreditTransaction[]
}

model ServiceEntry {
  id                 String            @id @default(cuid())
  submissionId       String
  submission         ServiceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  activityTemplateId String?
  activityTemplate   ActivityTemplate? @relation(fields: [activityTemplateId], references: [id])
  customActivityName String?

  month              Int               // 1-12
  year               Int
  quantity           Int               @default(0)

  @@index([submissionId])
}

model EvidenceFile {
  id           String            @id @default(cuid())
  submissionId String
  submission   ServiceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  uploadedAt   DateTime          @default(now())
}

model Webinar {
  id               String   @id @default(cuid())
  title            String
  description      String
  eventDate        DateTime
  registrationLink String
  createdById      String
  createdBy        User     @relation("WebinarCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
}

model JobPosting {
  id          String   @id @default(cuid())
  title       String
  institution String
  description String
  location    String
  applyLink   String
  expiresAt   DateTime
  createdById String
  createdBy   User     @relation("JobPostingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Admin-editable app settings (e.g. topup WhatsApp number, price text).
// Missing keys fall back to the matching env var — see src/lib/settings.ts.
model Setting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // WEBINAR | LOKER
  createdAt DateTime @default(now())

  @@unique([userId, type])
}

// Permintaan topup kredit dengan bukti transfer; admin menyetujui/menolak.
// Persetujuan menambah kredit + mencatat CreditTransaction secara atomik.
model TopupRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("TopupOwner", fields: [userId], references: [id], onDelete: Cascade)
  credits      Int
  note         String?
  proofUrl     String
  proofName    String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?     @relation("TopupReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

// Analitik pengunjung tanpa cookie: visitorHash = hash(IP+UA+hari) yang berganti
// tiap hari, jadi tidak bisa melacak orang lintas hari. `day` = YYYY-MM-DD (WIB).
model PageView {
  id          String   @id @default(cuid())
  path        String
  day         String
  visitorHash String
  referrer    String?
  device      String   // mobile | desktop
  createdAt   DateTime @default(now())

  @@index([day])
  @@index([path])
}

// Token reset password sekali pakai. Hanya hash SHA-256 yang disimpan (token asli
// hanya ada di tautan), berlaku 1 jam. createdById terisi bila dibuat oleh admin.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
