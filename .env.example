# Production (.env next to docker-compose.yml on the VPS)
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Public URL of the app (must match the domain in the UNSPSC Caddyfile)
AUTH_URL=https://temannakes.aisatira.web.id
SEED_ADMIN_EMAIL=admin@temannakes.id
SEED_ADMIN_PASSWORD=
# Opsional: akun nakes uji (dibuat saat seed bila keduanya diisi)
SEED_TEST_NAKES_EMAIL=
SEED_TEST_NAKES_PASSWORD=
# Opsional: email reset password (tanpa ini, admin membuat tautan reset di /admin/users)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="TemanNakes <temannakes2026@gmail.com>"
# Gmail: aktifkan verifikasi 2 langkah, buat "Sandi aplikasi", lalu
#   SMTP_URL=smtps://temannakes2026%40gmail.com:SANDI_APLIKASI@smtp.gmail.com:465
# Bila SMTP aktif: pendaftar baru wajib verifikasi email sebelum bisa login.
# Topup page: WhatsApp number in 62xxx format (no +) and price text shown to nakes
ADMIN_WHATSAPP=
CREDIT_PRICE_LABEL=

