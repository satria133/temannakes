# Production (.env next to docker-compose.yml on the VPS)
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Public URL of the app (must match the domain in the UNSPSC Caddyfile)
AUTH_URL=https://temannakes.aisatira.web.id
SEED_ADMIN_EMAIL=admin@temannakes.id
SEED_ADMIN_PASSWORD=
# Opsional: akun nakes uji (dibuat saat seed bila keduanya diisi)
SEED_TEST_NAKES_EMAIL=
SEED_TEST_NAKES_PASSWORD=
# Topup page: WhatsApp number in 62xxx format (no +) and price text shown to nakes
ADMIN_WHATSAPP=
CREDIT_PRICE_LABEL=

